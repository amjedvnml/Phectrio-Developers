{
  "name": "Phectrio-developers-root",
  "version": "1.0.0",
  "description": "Phectrio Developers - Full-Stack MERN Agency Web Application",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta.bold,cyan.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm run build",
    "start": "cd server && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "mongodb": "^7.6.0"
  }
}
